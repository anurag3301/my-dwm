#!/bin/bash

# Gets temperature of the CPU
# Dependencies: lm_sensors

PREFIX=' '
FIRE='󱗗 '

WARNING_LEVEL=80

get_cputemp()
{
	# CPU_T=$(cat /sys/devices/platform/coretemp.0/hwmon/hwmon?/temp2_input)
	# CPU_TEMP=$(expr $CPU_T / 1000)

	CPU_TEMP=""
	for h in /sys/class/hwmon/hwmon*; do
		if [ "$(cat "$h/name")" = "k10temp" ]; then
			CPU_TEMP=$(( $(cat "$h/temp1_input") / 1000 ))
			break
		fi
	done
	[ -z "$CPU_TEMP" ] && exit 0

	if [ "$CPU_TEMP" -ge $WARNING_LEVEL ]; then
		PREFIX="$FIRE$PREFIX"
	fi

	# green when cool, yellow warm, orange hot, red critical
	if   [ "$CPU_TEMP" -ge 85 ]; then COLOR='\x03'; ICOLOR='\x16'
	elif [ "$CPU_TEMP" -ge 70 ]; then COLOR='\x05'; ICOLOR='\x15'
	elif [ "$CPU_TEMP" -ge 55 ]; then COLOR='\x04'; ICOLOR='\x13'
	else COLOR='\x06'; ICOLOR='\x0e'
	fi

	printf "${ICOLOR} %s${COLOR} %s\x01\\n" "$PREFIX" "$CPU_TEMP°C"
}

get_cputemp
